# ──────────────────────────────────────────────────────────────────
#  BonCadeau – Template de variables d'environnement
#  Copier ce fichier en .env et remplir toutes les valeurs.
# ──────────────────────────────────────────────────────────────────

# ─── Application ───────────────────────────────────────────────────
APP_URL=http://VOTRE_IP_OU_DOMAINE:8080
FRONTEND_PORT=8080

# ─── Base de données MySQL ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changez_ce_mot_de_passe_root
MYSQL_DATABASE=boncadeau
MYSQL_USER=boncadeau_user
MYSQL_PASSWORD=changez_ce_mot_de_passe_db

# ─── API Node.js ────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue
CORS_ORIGIN=*

# ─── SMTP (envoi d'e-mails) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
EMAIL_FROM=BonCadeau SN <votre_email@gmail.com>
